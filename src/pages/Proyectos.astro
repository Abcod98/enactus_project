---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

// Agregamos imagen y descripción para cada proyecto
const proyectos = [
    {
        nombre: "Amaranto",
        ruta: "amaranto",
        imagen: "https://encrypted-tbn2.gstatic.com/images?q=tbn:ANd9GcQZhla7D_4G4luWsYy-y2OmzaR2uIOv-Zc39IzUEjaUjvujaY7IVY-5yu15bzWDNSUr6zV4WdMZcxmishecZQJK13yTmhKzVDPh58p7SRBc-A",
        descripcion:
            "Cultivo ancestral con alto valor nutritivo y potencial económico.",
    },
    {
        nombre: "Ruta turística",
        ruta: "ruta-turistica",
        imagen: "https://agn.gt/wp-content/uploads/2023/10/importancia-del-tul.jpg",
        descripcion:
            "Proyecto que promueve el turismo local y la cultura regional.",
    },
    {
        nombre: "Abono orgánico",
        ruta: "abono-organico",
        imagen: "data:image/jpeg;base64,",
        descripcion:
            "Transformamos residuos en fertilizante ecológico y sostenible.",
    },
    {
        nombre: "Artesanías",
        ruta: "artesanias",
        imagen: "data:image/jpeg;base64,",
        descripcion:
            "Promovemos el arte local y generamos ingresos para las comunidades.",
    },
    {
        nombre: "La miel",
        ruta: "la-miel",
        imagen: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTKNNLXJjBVCab4wH3iVc5NeTcVuJHF-HZM7A&s",
        descripcion: "Producción de miel natural que apoya la biodiversidad.",
    },
    {
        nombre: "Próximo proyecto",
        ruta: "proximo",
        imagen: "https://upload.wikimedia.org/wikipedia/commons/3/3a/Coming-soon-image.jpg",
        descripcion: "¡Muy pronto lanzaremos una nueva iniciativa innovadora!",
    },
];
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <title>Enactus UVG Altiplano</title>
    </head>
    <body>
        <Navbar />
        <section class="section">
            <h2>Proyectos Sostenibles</h2>
            <div
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-top: 2rem;"
            >
                {
                    proyectos.map(({ nombre, ruta, imagen, descripcion }) => (
                        <div class="card">
                            <img
                                src={imagen}
                                alt={nombre}
                                style="width: 100%; border-radius: 8px; margin-bottom: 1rem;"
                            />
                            <h3>{nombre}</h3>
                            <p>{descripcion}</p>
                            <a href={`/proyectos/${ruta}`} class="button">
                                Ver más
                            </a>
                        </div>
                    ))
                }
            </div>
        </section>
    </body>
</html>
