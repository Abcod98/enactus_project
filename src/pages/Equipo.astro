---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

// Tipado de los miembros del equipo
interface Miembro {
    nombre: string;
    rol: string;
}

const equipo: Miembro[] = [
    { nombre: "Abner Chopen", rol: "Presidente" },
    { nombre: "Sara Gallardo", rol: "Vicepresidenta" },
    { nombre: "Juan Tuyuc", rol: "Secretario De Proyectos" },
    { nombre: "Brayan Calima", rol: "Proyectos" },
    { nombre: "Celeste Pacheco", rol: "Proyectos" },
    { nombre: "Raquel Reyes", rol: "Marketing" },
    { nombre: "Lili Chumil", rol: "Marketing" },
    { nombre: "Marta Tzorin", rol: "Marketing" },
    { nombre: "Rosangela Guarcax", rol: "Marketing" },
    { nombre: "Natan Saquic", rol: "Marketing" },
    { nombre: "Miriam Guzman", rol: "Recursos Humanos" },
    { nombre: "Stephany Vail", rol: "Relaciones Exteriores" },
    { nombre: "Dina Suy", rol: "Finanzas" },
    { nombre: "Juan Ixcamparic", rol: "Finanzas" },
    { nombre: "Manuela Cumes", rol: "Gestiones" },
];

// Función para generar la ruta de la foto
function generarRutaFoto(nombre: string): string {
    return `/src/assets/equipo/${nombre
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "") // quita acentos
        .replace(/\s+/g, "-") // espacios a guiones
        .toLowerCase()}.jpg`; // formato JPG
}
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <title>Equipo - Enactus</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    </head>
    <body>
        <Navbar />
        <section class="section">
            <h2 style="text-align: center;">Nuestro Equipo</h2>
            <div
                style="display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 2rem; justify-content: center;"
            >
                {
                    equipo.map(({ nombre, rol }) => (
                        <div
                            class="card"
                            style="width: 250px; text-align: center;"
                        >
                            <img
                                src={generarRutaFoto(nombre)}
                                alt={nombre}
                                style="width: 160px; height: 200px; object-fit: cover; margin-bottom: 1rem;"
                            />
                            <h3>{nombre}</h3>
                            <p>{rol}</p>
                        </div>
                    ))
                }
            </div>
        </section>
    </body>
</html>
